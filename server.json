{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.SatPaingOo/kiriya",
  "title": "kiriya",
  "description": "Developer tools for files, git, ports, processes and more, the same on Windows, Linux and macOS",
  "repository": {
    "url": "https://github.com/SatPaingOo/kiriya",
    "source": "github"
  },
  "version": "0.1.2",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "kiriya",
      "version": "0.1.2",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "description": "A folder the agent may reach; repeat it for more. The current folder when left out",
          "format": "filepath",
          "isRequired": false,
          "isRepeated": true
        }
      ]
    }
  ]
}
